# BOND-API Configuration — reference copy for new projects
# Copy to config.yaml and edit. Loaded by
# src/bond_api/manuscript_variables.py::load_manuscript_config and hydrated
# into {{TOKEN}}s by scripts/z_generate_manuscript_variables.py.

paper:
  # RASP Standard: Title must be descriptive and objective
  title: "BOND-API: The Frozen Mission Protocol Contract for the BOND Film Suite"
  subtitle: "Layer 1 — protocol, discovery, registry, and serialization"
  version: "0.1.0"
  date: "2026-08-04"

authors:
  - name: "Daniel Ari Friedman"
    orcid: "0000-0001-6232-9096"
    email: "daniel@activeinference.institute"
    affiliation: "Active Inference Institute"
    corresponding: true

publication:
  github_repository: "docxology/bond-api"
  repository_url: "https://github.com/docxology/bond-api"
  journal: "BOND Suite Technical Series"
  year: "2026"

keywords:
  - "mission protocol"
  - "frozen contract"
  - "film agents"
  - "deterministic serialization"
  - "plugin discovery"
  - "reproducible research"

metadata:
  license: "MIT"
  language: "en"

render:
  formats:
    pdf: true
    html: true
    slides: true
    docx: false
    epub: false

testing:
  max_test_failures: 0
  max_infra_test_failures: 0
  max_project_test_failures: 0

protocol:
  identity: "BOND-API"
  codename: "THE PROTOCOL"
  reference_film: "sable"
  serialization_tag: "__bond_type__"
